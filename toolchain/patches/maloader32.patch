 static void* ld_mac_dlopen(const char* filename, int flag) {
+  // ckz2: dlopen(NULL) means the main program. mono-xcompiler only asks it for
+  // "__Internal" P/Invoke targets and never calls them; an empty export table is enough.
+  if (filename == NULL) {
+    return new Exports();
+  }
   LOG << "ld_mac_dlopen: " << filename << " " << flag << endl;
 
+  // ckz2: like the real dlopen, a missing file is a soft failure. Mac mono probes
+  // CoreFoundation at startup and skips the workaround when dlopen returns NULL.
+  if (access(filename, F_OK) != 0) {
+    ld_mac_dlerror_is_set = true;
+    ld_mac_dlerror_buf = string(filename) + ": cannot open shared object file";
+    return NULL;
+  }
